    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@davecode/core": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  }
}
